# Supabase → Connect → ORMs → Prisma
# Pooler (Supavisor, modo transação, porta 6543): usado pelo app em runtime.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta/sessão (porta 5432): usada pelo Prisma para migrations.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Opcional: só para `npm run db:seed`. Nunca use no front-end.
SUPABASE_SECRET_KEY="sb_secret_..."

# Stripe (Cervo Pro). Em produção: `npx wrangler secret put STRIPE_SECRET_KEY` e `... STRIPE_WEBHOOK_SECRET`.
# Localmente, coloque as chaves de TESTE (sk_test_...) num .env.local (não vai para o git).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
