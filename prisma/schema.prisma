/// Cliente do app: roda no Cloudflare Workers e também no `next dev` (o Turbopack trata o .wasm).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

/// Cliente para scripts em Node puro (seed via tsx), que não carregam o .wasm do modo Cloudflare.
generator node {
  provider = "prisma-client"
  output   = "../src/generated/prisma-node"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum GoalType {
  PAGES
  MINUTES
}

enum LibraryStatus {
  WANT
  READING
  DONE
}

enum ClubVisibility {
  PRIVATE
  PUBLIC
}

enum ReadingMode {
  /// Todos leem o livro do clube
  FIXED
  /// Cada membro lê o livro que quiser
  FREE
}

enum ClubRole {
  OWNER
  /// Ajuda o dono: edita o clube e remove membros comuns
  ADMIN
  MEMBER
}

/// Perfil do app. O id é o mesmo do usuário no Supabase Auth (auth.users.id).
model User {
  id          String    @id
  name        String
  email       String    @unique
  goalType    GoalType?
  dailyGoal   Int?
  /// Preenchido quando o usuário conclui o onboarding
  onboardedAt DateTime?
  /// Pro de cortesia até esta data (fundadores), independente do Stripe
  proUntil    DateTime?
  createdAt   DateTime  @default(now())

  books       Book[]
  library     LibraryItem[]
  memberships ClubMember[]
  clubsOwned  Club[]        @relation("ClubOwner")
  invites     Invite[]
  checkIns    CheckIn[]
  comments    Comment[]
  reactions   Reaction[]
  feedbacks   Feedback[]
  /// Pedidos de amizade que o usuário enviou / recebeu (amizade = pedido aceito)
  friendRequestsSent     Friendship[] @relation("FriendRequester")
  friendRequestsReceived Friendship[] @relation("FriendAddressee")
  subscription           Subscription?
  challengesCreated      ClubChallenge[]
}

/// Livro cadastrado manualmente por um usuário.
model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  totalPages  Int
  coverUrl    String?
  /// Quem cadastrou. Fica vazio se a conta for excluída: o livro continua na biblioteca dos outros.
  createdById String?
  createdAt   DateTime @default(now())

  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  libraryItems LibraryItem[]
  clubs        Club[]
  checkIns     CheckIn[]
}

/// Livro na biblioteca de um usuário.
model LibraryItem {
  id          String        @id @default(cuid())
  userId      String
  bookId      String
  status      LibraryStatus @default(WANT)
  currentPage Int           @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Club {
  id            String         @id @default(cuid())
  name          String
  description   String?
  ownerId       String
  bookId        String?
  /// Quando o livro atual do clube foi definido (base do ranking)
  bookStartedAt DateTime?
  /// Meta: data limite para terminar o livro atual
  goalEndDate   DateTime?
  /// Meta: páginas por semana
  weeklyPages   Int?
  /// PUBLIC aparece na busca e aceita entrada direta; PRIVATE só por convite
  visibility    ClubVisibility @default(PRIVATE)
  /// Limite de membros (null = sem limite)
  maxMembers    Int?
  readingMode   ReadingMode    @default(FIXED)
  createdAt     DateTime       @default(now())

  owner   User         @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  book    Book?        @relation(fields: [bookId], references: [id], onDelete: SetNull)
  members    ClubMember[]
  invites    Invite[]
  challenges ClubChallenge[]
}

model ClubMember {
  id       String   @id @default(cuid())
  clubId   String
  userId   String
  role     ClubRole @default(MEMBER)
  joinedAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  clubId      String
  createdById String
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  club      Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

/// Registro de leitura. day = data local (YYYY-MM-DD) usada para streaks.
model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  fromPage  Int
  toPage    Int
  pagesRead Int
  /// Minutos de leitura (opcional; usado por metas em minutos)
  minutes   Int?
  note      String?
  /// Foto opcional do momento da leitura (caminho /fotos/... no R2)
  photoUrl  String?
  day       String
  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions Reaction[]

  @@index([userId, day])
  @@index([bookId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  checkInId String
  userId    String
  body      String
  createdAt DateTime @default(now())

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([checkInId])
}

/// Reação (emoji) de um usuário a um check-in do feed.
model Reaction {
  id        String   @id @default(cuid())
  checkInId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([checkInId, userId, emoji])
  @@index([checkInId])
}

enum FeedbackKind {
  BUG
  IDEA
  PRAISE
  OTHER
}

/// Feedback sobre o app enviado pelo próprio usuário (lido no Supabase Studio).
model Feedback {
  id        String       @id @default(cuid())
  userId    String
  kind      FeedbackKind
  message   String
  /// Navegador/aparelho, ajuda a reproduzir bugs
  userAgent String?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/// Amizade entre dois leitores. Nasce como pedido (PENDING) e vira amizade quando o outro aceita.
/// Existe no máximo uma linha por par: quem pede para alguém que já tinha pedido aceita o pedido existente.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

/// Assinatura do Cervo Pro no Stripe (espelho do que o Stripe informa via webhook).
model Subscription {
  userId               String    @id
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  /// Status do Stripe: active, trialing, past_due, canceled, incomplete, unpaid...
  status               String
  /// month ou year
  interval             String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Desafio de um clube (recurso Pro do dono): ler em X dias dentro de um período.
model ClubChallenge {
  id          String   @id @default(cuid())
  clubId      String
  title       String
  targetDays  Int
  /// Datas no formato AAAA-MM-DD (mesmo de CheckIn.day)
  startsOn    String
  endsOn      String
  createdById String?
  createdAt   DateTime @default(now())

  club      Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clubId, endsOn])
}
