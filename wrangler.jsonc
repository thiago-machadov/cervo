{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cervo",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Proteção de custo: corta qualquer request que passe de 200 ms de CPU (o padrão é 30 s).
	// Requer o plano Workers Paid. Ajustar depois de ver o p99 de CPU em Metrics.
	"limits": {
		"cpu_ms": 200
	},
	// Roda o Worker ao lado do banco (Supabase em aws us-east-1) em vez de perto do usuário:
	// cada página faz várias consultas, e cada uma vira uma ida e volta curta.
	// O modo "smart" tinha escolhido Amsterdã (longe do banco e do Brasil), por isso a região fixa.
	"placement": {
		"mode": "targeted",
		"region": "aws:us-east-1"
	},
	// Pool de conexões da Cloudflare na frente do Supabase (session pooler, porta 5432), cache de consultas desligado.
	// Evita abrir conexão TLS nova com o banco a cada request. No `next dev` o app usa DATABASE_URL direto;
	// localConnectionString (Supabase local, credenciais padrão) só serve para o wrangler simular o binding.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "6fcffb6a790e47bb9387383c04db479f",
			"localConnectionString": "postgresql://postgres:postgres@127.0.0.1:55422/postgres"
		}
	],
	// Fotos das capas dos livros (no `next dev` usa um R2 simulado em .wrangler/state).
	"r2_buckets": [
		{ "binding": "COVERS", "bucket_name": "cervo-capas" }
	],
	// Domínios próprios: a Cloudflare cria o DNS e o certificado HTTPS no deploy
	// (exige o domínio ativo na conta, com os nameservers apontando para a Cloudflare).
	"routes": [
		{ "pattern": "cervobook.club", "custom_domain": true },
		{ "pattern": "www.cervobook.club", "custom_domain": true }
	]
	// Sem cache incremental (R2): todas as páginas dependem da sessão e são renderizadas por request.
	// Variáveis: NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (build e runtime)
	// e DATABASE_URL como secret, configuradas no painel da Cloudflare.
}
